#include <AFMotor.h> // Adafruit Motor Shield library
AF_DCMotor motor1(1, MOTOR12_8KHZ); // left motor on M1
AF_DCMotor motor2(2, MOTOR12_8KHZ); // right motor on M2
int sp = 85; // motor speed
void setup() {
delay(1000);
pinMode(A0, INPUT);
pinMode(A1, INPUT);
pinMode(A2, INPUT);
pinMode(A3, INPUT);
pinMode(A4, INPUT);
analogWrite(2, 255);
}
void loop() {
int t = 100; // threshold
int l, r, left, right, middle;
l = analogRead(A0) + analogRead(A1);
r = analogRead(A3) + analogRead(A4);
middle = analogRead(A2);
left = l / 2;
right = r / 2;
if (left < t && right < t) { // move forward
motor1.setSpeed(sp);
motor2.setSpeed(sp);
motor1.run(FORWARD);
motor2.run(FORWARD);
}
else if (left < t && right > t) { // turn right
while (left < t && right > t) {
motor1.setSpeed(sp);
motor2.setSpeed(sp);
motor1.run(BACKWARD);
motor2.run(FORWARD);
left = (analogRead(A0) + analogRead(A1)) / 2;
right = (analogRead(A3) + analogRead(A4)) / 2;
}
}
else if (left > t && right < t) { // turn left
while (left > t && right < t) {
motor1.setSpeed(sp);
motor2.setSpeed(sp);
motor1.run(FORWARD);
motor2.run(BACKWARD);
left = (analogRead(A0) + analogRead(A1)) / 2;
right = (analogRead(A3) + analogRead(A4)) / 2;
}
}
else if (left > t && right > t && middle > t) { // stop (cross line)
while (left > t && right > t && middle > t) {
motor1.run(RELEASE);
motor2.run(RELEASE);
}
}
}
